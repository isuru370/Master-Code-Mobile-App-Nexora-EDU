<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG builds only (flutter run): allow plain http:// so the app can talk
    to a Laravel server on the local network, e.g. http://192.168.1.10:8000.
    Release builds use src/main/res/xml/network_security_config.xml (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
